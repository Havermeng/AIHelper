<UserControl x:Class="AIHelper.VisualStudioExtension.AIHelperSessionsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="420"
             MinHeight="320">
    <Grid Background="#1B1F24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="12"
                Background="#111820"
                BorderBrush="#2D3A46"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Text="Сессии AIHelper" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="#B7C7D4"
                               Text="{Binding StatusText}" />
                </StackPanel>
                <Button Grid.Column="1"
                        MinWidth="92"
                        Margin="12,0,0,0"
                        Padding="10,6"
                        Click="RefreshButton_Click"
                        Content="Обновить" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBox Grid.ColumnSpan="3"
                     Margin="0,0,0,10"
                     Padding="10,7"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по названию, источнику, ID, пути, модели или превью" />

            <ListView Grid.Row="1"
                      ItemsSource="{Binding FilteredSessions}"
                      SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Width="86"
                                        Header="Источник"
                                        DisplayMemberBinding="{Binding Source}" />
                        <GridViewColumn Width="320"
                                        Header="Сессия"
                                        DisplayMemberBinding="{Binding Title}" />
                        <GridViewColumn Width="132"
                                        Header="Обновлена"
                                        DisplayMemberBinding="{Binding UpdatedAtText}" />
                        <GridViewColumn Width="72"
                                        Header="Сообщ."
                                        DisplayMemberBinding="{Binding TotalMessageCount}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="1"
                    Grid.Column="2"
                    Padding="12"
                    Background="#111820"
                    BorderBrush="#2D3A46"
                    BorderThickness="1"
                    CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="#FFFFFF"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedSession.Title, TargetNullValue=Выберите сессию}" />
                        <TextBlock Margin="0,8,0,0"
                                   Foreground="#B7C7D4"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedSession.Preview}" />
                        <TextBlock Margin="0,12,0,0"
                                   Foreground="#FFFFFF"
                                   Text="{Binding SelectedSession.Source, StringFormat=Источник: {0}}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#B7C7D4"
                                   Text="{Binding SelectedSession.ModelProvider, StringFormat=Модель: {0}}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#B7C7D4"
                                   Text="{Binding SelectedSession.SessionId, StringFormat=ID: {0}}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#B7C7D4"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedSession.WorkingDirectory, StringFormat=Рабочая папка: {0}}" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="#B7C7D4"
                                   TextWrapping="Wrap"
                                   Text="{Binding SelectedSession.FilePath, StringFormat=Файл: {0}}" />

                        <TextBlock Margin="0,14,0,4"
                                   Foreground="#FFFFFF"
                                   FontWeight="Bold"
                                   Text="Continue with" />
                        <ComboBox Margin="0,0,0,8"
                                  ItemsSource="{Binding ResumeTools}"
                                  SelectedItem="{Binding SelectedResumeTool, Mode=TwoWay}" />
                        <UniformGrid Columns="2">
                            <Button Margin="0,0,6,8"
                                    Click="ResumeButton_Click"
                                    Content="Continue" />
                            <Button Margin="6,0,0,8"
                                    Click="CopyResumeCommandButton_Click"
                                    Content="Copy command" />
                        </UniformGrid>

                        <UniformGrid Margin="0,14,0,0"
                                     Columns="2">
                            <Button Margin="0,0,6,8"
                                    Click="OpenFileButton_Click"
                                    Content="Открыть файл" />
                            <Button Margin="6,0,0,8"
                                    Click="OpenFolderButton_Click"
                                    Content="Открыть папку" />
                            <Button Margin="0,0,6,0"
                                    Click="CopyIdButton_Click"
                                    Content="Копировать ID" />
                            <Button Margin="6,0,0,0"
                                    Click="OpenFeedButton_Click"
                                    Content="Открыть фид" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock Grid.Row="2"
                   Padding="12,0,12,10"
                   Foreground="#8EA3B3"
                   Text="{Binding FeedPath}" />
    </Grid>
</UserControl>
