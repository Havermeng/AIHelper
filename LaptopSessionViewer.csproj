<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>AIHelper</AssemblyName>
    <Product>AIHelper</Product>
    <AssemblyTitle>AIHelper</AssemblyTitle>
    <Version>1.2.0</Version>
    <AssemblyVersion>1.2.0.0</AssemblyVersion>
    <FileVersion>1.2.0.0</FileVersion>
    <ApplicationIcon>Assets\AIHelper.ico</ApplicationIcon>
    <RootNamespace>LaptopSessionViewer</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <ReadyToRunUseCrossgen2>true</ReadyToRunUseCrossgen2>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentIcons.Wpf" Version="2.1.333" />
    <Compile Remove="AIHelper.VisualStudioExtension\**\*.cs" />
    <Page Remove="AIHelper.VisualStudioExtension\**\*.xaml" />
    <None Remove="AIHelper.VisualStudioExtension\**\*" />
    <Content Remove="AIHelper.VisualStudioExtension\**\*" />
    <Resource Include="Assets\AIHelper.ico" />
    <Content Include="Assets\dns-presets-example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>




