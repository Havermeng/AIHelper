                                                   Foreground="#FFFDF9"
                                                   Text="{Binding Strings[SetupStartHereTitle]}" />
                                        <TextBlock Margin="0,8,0,0"
                                                   Foreground="#C3D2DC"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Strings[SetupStartHereText]}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <Grid Visibility="{Binding SettingsSectionVisibility}"
                  DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="18"
                        CornerRadius="24"
                        BorderBrush="#355465"
                        BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#132734" Offset="0" />
                            <GradientStop Color="#274552" Offset="0.65" />
                            <GradientStop Color="#D97732" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <StackPanel>
                        <TextBlock FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#FFFDF9"
                                   Text="{Binding Strings[SettingsTitle]}" />
                        <TextBlock Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#F8E7D6"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[SettingsSubtitle]}" />
                        <StackPanel Margin="0,16,0,0"
                                    Orientation="Horizontal">
                            <Button Style="{StaticResource SessionTabButtonStyle}"
                                    Click="NeuralSettingsTabButton_Click"
                                    Visibility="{Binding ExpertOnlyVisibility}"
                                    Background="{Binding NeuralSettingsTabBackground}"
                                    BorderBrush="{Binding NeuralSettingsTabBackground}"
                                    Foreground="{Binding NeuralSettingsTabForeground}"
                                    Content="{Binding Strings[SettingsNeuralTab]}" />
                            <Button Style="{StaticResource SessionTabButtonStyle}"
                                    Click="AppSettingsTabButton_Click"
                                    Background="{Binding AppSettingsTabBackground}"
                                    BorderBrush="{Binding AppSettingsTabBackground}"
                                    Foreground="{Binding AppSettingsTabForeground}"
                                    Content="{Binding Strings[SettingsAppTab]}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding SectionRailGapColumnWidth}" />
                        <ColumnDefinition Width="{Binding SettingsAsideColumnWidth}" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#FFFDF9"
                            CornerRadius="28"
                            Padding="20"
                            BorderBrush="#E7DBCC"
                            BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <StackPanel Visibility="{Binding NeuralSettingsTabVisibility}">
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#16212B"
                                               Text="{Binding Strings[SettingsNeuralTitle]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#475467"
                                               TextWrapping="Wrap"
                                               Text="{Binding Strings[SettingsNeuralSubtitle]}" />

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            CornerRadius="22"
                                            Background="#F7F3EC">
                                        <StackPanel>
                                            <TextBlock FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#16212B"
                                                       Text="{Binding Strings[SettingsDangerousAccessTitle]}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="#475467"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Strings[SettingsDangerousAccessHelp]}" />
                                            <CheckBox Margin="0,14,0,0"
                                                      IsChecked="{Binding SettingsDangerousFullAccess, Mode=TwoWay}"
                                                      Content="{Binding Strings[SettingsDangerousAccessToggle]}" />
                                            <Button Margin="0,10,0,0"
                                                    Click="ApplyDangerousAccessSettingsButton_Click"
                                                    Content="{Binding Strings[SettingsDangerousAccessApplyButton]}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            CornerRadius="22"
                                            Background="#F7F3EC">
                                        <StackPanel>
                                            <Border HorizontalAlignment="Left"
                                                    Padding="10,4"
                                                    CornerRadius="12"
                                                    Background="#FCE7C3">
                                                <TextBlock FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#B86E10"
                                                           Text="{Binding Strings[SettingsExperimentalBadge]}" />
                                            </Border>
                                            <TextBlock FontSize="16"
                                                       Margin="0,10,0,0"
                                                       FontWeight="Bold"
                                                       Foreground="#16212B"
                                                       Text="{Binding Strings[SettingsPhotoPasteFixTitle]}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="#475467"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Strings[SettingsPhotoPasteFixHelp]}" />
                                            <Border Margin="0,12,0,0"
                                                    Padding="12"
                                                    CornerRadius="16"
                                                    Background="{Binding SettingsPhotoPasteFixStateBrush}">
                                                <TextBlock Foreground="{Binding SettingsPhotoPasteFixStateForeground}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding SettingsPhotoPasteFixStateText}" />
                                            </Border>
                                            <CheckBox Margin="0,14,0,0"
                                                      IsChecked="{Binding SettingsPhotoPasteFixEnabled, Mode=TwoWay}"
                                                      Content="{Binding Strings[SettingsPhotoPasteFixToggle]}" />
                                            <Button Margin="0,10,0,0"
                                                    Click="ApplyPhotoPasteFixSettingsButton_Click"
                                                    Content="{Binding Strings[SettingsPhotoPasteFixApplyButton]}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,18,0,0"
                                            Padding="12"
                                            CornerRadius="16"
                                            Background="#16212B">
                                        <TextBlock Foreground="{Binding SettingsStatusForeground}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding SettingsStatusText}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding AppSettingsTabVisibility}">
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#16212B"
                                               Text="{Binding Strings[SettingsAppTitle]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#475467"
                                               TextWrapping="Wrap"
                                               Text="{Binding Strings[SettingsAppSubtitle]}" />

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            CornerRadius="22"
                                            Background="#F7F3EC">
                                        <StackPanel>
                                            <TextBlock FontSize="16" FontWeight="Bold" Foreground="#16212B"
                                                       Text="{Binding Strings[SettingsExperienceTitle]}" />
                                            <TextBlock Margin="0,8,0,0" Foreground="#475467" TextWrapping="Wrap"
                                                       Text="{Binding Strings[SettingsExperienceHelp]}" />
                                            <CheckBox Margin="0,14,0,0"
                                                      IsChecked="{Binding IsBeginnerModeEnabled, Mode=TwoWay}"
                                                      Content="{Binding Strings[SettingsExperienceToggle]}" />
                                            <Button Margin="0,10,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                                    Click="ReplayBeginnerOnboardingButton_Click"
                                                    Content="{Binding Strings[SettingsReplayOnboarding]}" />
                                        </StackPanel>
                                    </Border>

                                    <Border Margin="0,18,0,0"
                                            Padding="16"
                                            CornerRadius="22"
                                            Background="#F7F3EC">
                                        <StackPanel>
                                            <TextBlock FontSize="16"
                                                       FontWeight="Bold"
                                                       Foreground="#16212B"
                                                       Text="{Binding Strings[SettingsLanguageTitle]}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       Foreground="#475467"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding Strings[SettingsLanguageHelp]}" />
                                            <TextBlock Margin="0,14,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="#16212B"
                                                       Text="{Binding Strings[LanguageLabel]}" />
                                            <ComboBox Margin="0,8,0,0"
                                                      ItemsSource="{Binding LanguageOptions}"
                                                      SelectedItem="{Binding SelectedLanguageOption, Mode=TwoWay}"
                                                      DisplayMemberPath="DisplayName" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2"
                            Background="#16212B"
                            CornerRadius="28"
                            Padding="20">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <Grid>
                                <StackPanel Visibility="{Binding NeuralSettingsTabVisibility}">
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[SettingsNeuralInfoTitle]}" />
                                    <Border Margin="0,14,0,0"
                                            Padding="16"
                                            CornerRadius="20"
                                            Background="#1D3545">
                                        <TextBlock Foreground="#E9EEF2"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Strings[SettingsNeuralInfoBody]}" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Visibility="{Binding AppSettingsTabVisibility}">
                                    <TextBlock FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[UpdateTitle]}" />

                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="12" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9FB7C5"
                                                   Text="{Binding Strings[UpdateCurrentVersionLabel]}" />
                                        <TextBlock Grid.Column="2"
                                                   Foreground="#FFFDF9"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding CurrentAppVersionText}" />

                                        <TextBlock Grid.Row="2"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9FB7C5"
                                                   Text="{Binding Strings[UpdateLatestVersionLabel]}" />
                                        <TextBlock Grid.Row="2"
                                                   Grid.Column="2"
                                                   Foreground="#FFFDF9"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding LatestAppVersionText}" />

                                        <TextBlock Grid.Row="4"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9FB7C5"
                                                   Text="{Binding Strings[UpdateReleaseTitleLabel]}" />
                                        <TextBlock Grid.Row="4"
                                                   Grid.Column="2"
                                                   Foreground="#FFFDF9"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding UpdateReleaseTitleText}" />

                                        <TextBlock Grid.Row="6"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="#9FB7C5"
                                                   Text="{Binding Strings[UpdatePublishedLabel]}" />
                                        <TextBlock Grid.Row="6"
                                                   Grid.Column="2"
                                                   Foreground="#FFFDF9"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding UpdatePublishedText}" />
                                    </Grid>

                                    <Button Margin="0,16,0,0"
                                            Click="CheckForUpdatesButton_Click"
                                            IsEnabled="{Binding CanCheckForUpdates}"
                                            Content="{Binding Strings[UpdateCheckButton]}" />
                                    <Button Margin="0,10,0,0"
                                            Click="DownloadUpdateButton_Click"
                                            IsEnabled="{Binding CanDownloadUpdate}"
                                            Content="{Binding Strings[UpdateDownloadButton]}" />
                                    <Button Margin="0,10,0,0"
                                            Click="OpenReleasePageButton_Click"
                                            IsEnabled="{Binding CanOpenReleasePage}"
                                            Content="{Binding Strings[UpdateOpenReleaseButton]}" />

                                    <ProgressBar Margin="0,16,0,0"
                                                 Height="8"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsUpdateBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Margin="0,12,0,0"
                                               Foreground="{Binding UpdateStatusForeground}"
                                               TextWrapping="Wrap"
                                               Text="{Binding UpdateStatusText}" />
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
        </Border>
    </Grid>
</Window>




