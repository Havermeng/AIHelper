                                    </StackPanel>
                                </Button>
                                <Button Margin="0,0,8,0" Padding="12,7" Background="#E7D8CA" BorderBrush="#E7D8CA" Foreground="#16212B"
                                        AutomationProperties.Name="{Binding Strings[HomeExampleCode]}"
                                        Click="HomeExampleButton_Click" Tag="{Binding Strings[HomeExampleCodePrompt]}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:FluentIcon Width="16" Height="16" Margin="0,0,7,0" Foreground="#16212B" Icon="Code" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Strings[HomeExampleCode]}" />
                                    </StackPanel>
                                </Button>
                                <Button Padding="12,7" Background="#E7D8CA" BorderBrush="#E7D8CA" Foreground="#16212B"
                                        AutomationProperties.Name="{Binding Strings[HomeExampleText]}"
                                        Click="HomeExampleButton_Click" Tag="{Binding Strings[HomeExampleTextPrompt]}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:FluentIcon Width="16" Height="16" Margin="0,0,7,0" Foreground="#16212B" Icon="TextEditStyle" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Text="{Binding Strings[HomeExampleText]}" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <Border Margin="0,12,0,0"
                                    Padding="12,10"
                                    CornerRadius="14"
                                    Background="{Binding HomeLaunchStatusBackground}"
                                    Visibility="{Binding HomeLaunchStatusVisibility}">
                                <TextBlock Foreground="{Binding HomeLaunchStatusForeground}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           AutomationProperties.LiveSetting="Assertive"
                                           Text="{Binding HomeLaunchStatusText}" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="{Binding HomeSafetyColumnWidth}" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="14" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button Padding="16,12" HorizontalContentAlignment="Stretch" Background="{Binding HomeReadinessBrush}"
                                    AutomationProperties.Name="{Binding HomeReadinessText}"
                                    BorderBrush="{Binding HomeReadinessBrush}" Click="HomeOpenSetupButton_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <icons:FluentIcon Width="22" Height="22" Foreground="#FFFDF9" Icon="Settings" IconVariant="Regular" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="{Binding HomeReadinessText}" />
                                    <TextBlock Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding Strings[HomeReadinessLink]}" />
                                </Grid>
                            </Button>
                            <Border Grid.Row="2" Padding="18" CornerRadius="24" Background="#FFFDF9" BorderBrush="#E7DBCC" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[HomeRecentTitle]}" />
                                    <ItemsControl Grid.Row="2" Visibility="{Binding HomeRecentSessionsVisibility}" ItemsSource="{Binding HomeRecentSessions}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0,0,0,8" Padding="14,10" HorizontalContentAlignment="Stretch"
                                                        AutomationProperties.Name="{Binding Title}"
                                                        Background="#F7F3EC" BorderBrush="#F7F3EC" Foreground="#16212B"
                                                        Click="HomeRecentSessionButton_Click" Tag="{Binding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Title}" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#667085" Text="{Binding UpdatedAtText}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11" Text="{Binding Data.Strings[HomeRecentOpen], Source={StaticResource ViewModelProxy}}" />
                                                            <icons:FluentIcon Width="16" Height="16" Foreground="#16212B" Icon="ChevronRight" IconVariant="Regular" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Grid.Row="2" Visibility="{Binding HomeRecentSessionsEmptyVisibility}" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" Foreground="#667085" TextWrapping="Wrap" TextAlignment="Center"
                                               Text="{Binding Strings[HomeRecentEmpty]}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Grid.Column="2" Padding="20" CornerRadius="24" Background="#16212B">
                            <StackPanel>
                                <Border Width="50" Height="50" HorizontalAlignment="Left" CornerRadius="25" Background="#274452">
                                    <icons:FluentIcon Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Foreground="#F8E7D6" Icon="ShieldCheckmark" IconVariant="Regular" />
                                </Border>
                                <TextBlock Margin="0,16,0,0" FontSize="20" FontWeight="Bold" Foreground="#FFFDF9"
                                           TextWrapping="Wrap"
                                           Text="{Binding Strings[HomeSafeTitle]}" />
                                <TextBlock Margin="0,8,0,0" FontSize="13" Foreground="#C3D2DC" TextWrapping="Wrap"
                                           Text="{Binding Strings[HomeSafeBody]}" />
                                <StackPanel Margin="0,18,0,0">
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" Foreground="#7DD3A8" Icon="CheckmarkCircle" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#FFFDF9" Text="{Binding Strings[HomeSafePointWorkspace]}" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" Foreground="#7DD3A8" Icon="CheckmarkCircle" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#FFFDF9" Text="{Binding Strings[HomeSafePointApprovals]}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <icons:FluentIcon Width="17" Height="17" Margin="0,0,8,0" Foreground="#7DD3A8" Icon="CheckmarkCircle" IconVariant="Regular" />
                                        <TextBlock VerticalAlignment="Center" Foreground="#FFFDF9" Text="{Binding Strings[HomeSafePointControl]}" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Margin="0,22,0,0" Padding="10,7" Background="#274452" BorderBrush="#274452"
                                        AutomationProperties.Name="{Binding Strings[HomeAdvancedLaunch]}"
                                        Click="HomeOpenAdvancedLaunchButton_Click" Content="{Binding Strings[HomeAdvancedLaunch]}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
                </ScrollViewer>
            </Grid>

            <Grid Visibility="{Binding SessionsSectionVisibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                CornerRadius="18"
                BorderBrush="#355465"
                BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#132734" Offset="0" />
                    <GradientStop Color="#274552" Offset="0.65" />
                    <GradientStop Color="#D97732" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="6" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{Binding SessionsHeaderSearchColumnWidth}" />
