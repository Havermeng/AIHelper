                                                   Foreground="#344054"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding NewSessionAccessSummaryText}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="#344054"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding NewSessionDataRouteText}" />
