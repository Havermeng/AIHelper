                    <StackPanel>
                        <TextBlock FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#FFFDF9"
                                   Text="{Binding Strings[HeroTitle]}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="#F8E7D6"
                                   TextWrapping="Wrap"
                                   Text="{Binding Strings[HeroSubtitle]}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="12"
                            CornerRadius="18"
                            Background="#203240">
                        <StackPanel>
                            <TextBlock Margin="2,0,0,3"
                                       FontSize="12"
                                       Foreground="#FFFDF9"
                                       Text="{Binding Strings[SearchLabel]}" />
                            <TextBox AutomationProperties.Name="{Binding Strings[SearchLabel]}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="2,2,0,0"
                                       FontSize="9"
                                       Foreground="#F8E7D6"
                                       TextWrapping="Wrap"
                                       Text="{Binding Strings[SearchHelp]}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Visibility="{Binding ExpertOnlyVisibility}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource MetricCardStyle}">
                            <StackPanel>
                                <TextBlock FontSize="9"
                                           Foreground="#B7D0DA"
                                           Text="{Binding Strings[MetricTotalSessions]}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="#FFFDF9"
                                           Text="{Binding TotalSessions}" />
                            </StackPanel>
                        </Border>

                    <Border Grid.Column="1" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="9"
                                       Foreground="#B7D0DA"
                                       Text="{Binding Strings[MetricFavorites]}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFFDF9"
                                       Text="{Binding FavoriteSessions}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="9"
                                       Foreground="#B7D0DA"
                                       Text="{Binding Strings[MetricUpdatedToday]}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFFDF9"
                                       Text="{Binding UpdatedTodaySessions}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3"
                            Margin="0"
                            Style="{StaticResource MetricCardStyle}">
                        <StackPanel>
                            <TextBlock FontSize="9"
                                       Foreground="#B7D0DA"
                                       Text="{Binding Strings[MetricMessages]}" />
                            <TextBlock Margin="0,2,0,0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#FFFDF9"
                                       Text="{Binding TotalMessages}" />
                        </StackPanel>
                    </Border>
                    </Grid>

                    <Border Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10"
                            CornerRadius="18"
                            Background="#203240"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding SessionsActionButtonColumnWidth}" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="{Binding SessionsActionButtonColumnWidth}" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="6" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="RefreshButton_Click"
                                    IsEnabled="{Binding IsRefreshAvailable}"
                                    Content="{Binding Strings[Refresh]}" />
                            <Button Grid.Row="0"
                                    Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OpenSessionsFolderButton_Click"
                                    Content="{Binding Strings[OpenSessionsFolder]}" />
                            <Button Grid.Row="2"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="ResumeSelectedSessionButton_Click"
                                    IsEnabled="{Binding CanResumeSelectedSession}"
                                    Content="{Binding Strings[ResumeInTerminal]}" />
                            <Button Grid.Row="2"
                                    Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="ResumeSelectedSessionInOpenCodeButton_Click"
                                    IsEnabled="{Binding CanResumeSelectedSessionInOpenCode}"
                                    ToolTip="{Binding SelectedSessionOpenCodeBridgeText}"
                                    Content="{Binding OpenCodeResumeButtonText}" />
                            <Button Grid.Row="4"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="ToggleFavoriteButton_Click"
                                    Content="{Binding FavoriteButtonText}" />
                            <Button Grid.Row="4"
                                    Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="RefreshSelectedSessionOpenCodeBridgeButton_Click"
                                    IsEnabled="{Binding CanRefreshSelectedSessionOpenCodeBridge}"
                                    ToolTip="{Binding SelectedSessionOpenCodeBridgeText}"
                                    Content="{Binding Strings[RefreshOpenCodeBridge]}" />
                            <Button Grid.Row="6"
                                    Grid.Column="0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="OpenSelectedFileButton_Click"
                                    IsEnabled="{Binding CanOpenSelectedFile}"
                                    Content="{Binding Strings[OpenSessionFile]}" />
                            <Button Grid.Row="6"
                                    Grid.Column="2"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="DeleteSelectedSessionButton_Click"
                                    IsEnabled="{Binding CanDeleteSelectedSession}"
                                    Background="#B42318"
                                    BorderBrush="#B42318"
                                    Content="{Binding Strings[DeleteSession]}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
