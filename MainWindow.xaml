<Window x:Class="LaptopSessionViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
        xmlns:local="clr-namespace:LaptopSessionViewer"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Strings[AppTitle]}"
        Icon="pack://application:,,,/Assets/AIHelper.ico"
        Width="1360"
        Height="780"
        MinWidth="1180"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#F4EFE6"
        FontFamily="Bahnschrift"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:BindingProxy x:Key="ViewModelProxy"
                            Data="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />

        <Style x:Key="ButtonFocusVisualStyle" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="2"
                                CornerRadius="14"
                                BorderBrush="#1D6EA3"
                                BorderThickness="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MetricCardStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#1D3545" />
            <Setter Property="Height" Value="56" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFDF9" />
            <Setter Property="Background" Value="#A84A12" />
            <Setter Property="BorderBrush" Value="#A84A12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="14"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonChrome" Property="BorderBrush" Value="#1D6EA3" />
                                <Setter TargetName="ButtonChrome" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#8F380A" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="Background" Value="#D0D5DD" />
                    <Setter Property="BorderBrush" Value="#D0D5DD" />
                    <Setter Property="Foreground" Value="#344054" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#475467" />
            <Setter Property="BorderBrush" Value="#475467" />
            <Setter Property="Foreground" Value="#FFFDF9" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D0D5DD" />
                    <Setter Property="BorderBrush" Value="#D0D5DD" />
                    <Setter Property="Foreground" Value="#344054" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="Foreground" Value="#16212B" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFFDF9" />
                    <Setter Property="Foreground" Value="#667085" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="Foreground" Value="#16212B" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#FFFDF9" />
                    <Setter Property="Foreground" Value="#667085" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SidebarComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="PassiveComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="BorderBrush" Value="#FFFDF9" />
            <Style.Triggers>
                <Trigger Property="IsHitTestVisible" Value="False">
                    <Setter Property="Background" Value="#FFFDF9" />
                    <Setter Property="BorderBrush" Value="#FFFDF9" />
                    <Setter Property="Foreground" Value="#667085" />
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SideNavButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SideNavChrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SideNavChrome" Property="BorderBrush" Value="#7CC4FF" />
                                <Setter TargetName="SideNavChrome" Property="BorderThickness" Value="3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#16212B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,18,10" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SessionTabButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="128" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="CompactPillButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="148" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <Style x:Key="SetupActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,7" />
        </Style>

        <Style x:Key="SetupDangerActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SetupActionButtonStyle}">
            <Setter Property="Background" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#B42318" />
        </Style>

        <Style x:Key="SetupSectionToggleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetupSectionToggleButtonDarkStyle" TargetType="Button" BasedOn="{StaticResource SetupSectionToggleButtonStyle}">
            <Setter Property="Foreground" Value="#FFFDF9" />
        </Style>

        <Style x:Key="SetupSectionToggleHorizontalLineStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="2" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SetupSectionToggleVerticalLineStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="2" />
            <Setter Property="Height" Value="12" />
            <Setter Property="RadiusX" Value="1" />
            <Setter Property="RadiusY" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SetupSectionToggleBadgeStyle" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="#ECDED0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="SetupSectionToggleBadgeDarkStyle" TargetType="Border" BasedOn="{StaticResource SetupSectionToggleBadgeStyle}">
            <Setter Property="Background" Value="#355364" />
        </Style>

        <Style x:Key="DnsMiniButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DnsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,7" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SetupCheckItemTemplate">
            <Border Margin="0,0,0,12"
                    Padding="14"
                    CornerRadius="18"
                    Background="#F7F3EC">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#16212B"
                                   Text="{Binding Title}" />
                        <TextBlock Margin="0,6,0,0"
                                   Foreground="#475467"
                                   TextWrapping="Wrap"
                                   Text="{Binding Detail}" />
                    </StackPanel>

                    <Border Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="10,4"
                            CornerRadius="12"
                            Background="{Binding AccentBrush}">
                        <TextBlock FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#FFFDF9"
                                   Text="{Binding Status}" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFDF9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="RowBackground" Value="#FFFDF9" />
            <Setter Property="AlternatingRowBackground" Value="#F7F3EC" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="RowHeight" Value="76" />
            <Setter Property="ColumnHeaderHeight" Value="48" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="EnableColumnVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="True" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#ECDED0" />
            <Setter Property="Foreground" Value="#16212B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#16212B" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FDE6D3" />
                    <Setter Property="Foreground" Value="#16212B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="{Binding AppOuterMargin}" Background="#F4EFE6">
        <Border Width="{Binding AppContentWidth}"
                HorizontalAlignment="Center"
                Background="Transparent">
            <Grid DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding ShellSidebarColumnWidth}" />
                    <ColumnDefinition Width="{Binding ShellMainGapColumnWidth}" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Padding="16"
                CornerRadius="24"
                Background="#16212B"
                BorderBrush="#274452"
                BorderThickness="1">
            <Grid DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock FontSize="26"
                               FontWeight="Bold"
                               Foreground="#FFFDF9"
                               Text="{Binding Strings[AppTitle]}" />
                    <TextBlock Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="#B7D0DA"
                               TextWrapping="Wrap"
                               Text="{Binding Strings[SidebarSubtitle]}" />
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Click="HomeSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionHomeNav]}"
                            Background="{Binding HomeSectionButtonBackground}"
                            BorderBrush="{Binding HomeSectionButtonBackground}"
                            Foreground="{Binding HomeSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18"
                                              Height="18"
                                              Margin="0,0,10,0"
                                              Foreground="{Binding HomeSectionButtonForeground}"
                                              Icon="Home"
                                              IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Text="{Binding Strings[SectionHomeNav]}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Click="SessionsSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionSessionsNav]}"
                            Background="{Binding SessionsSectionButtonBackground}"
                            BorderBrush="{Binding SessionsSectionButtonBackground}"
                            Foreground="{Binding SessionsSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18" Height="18" Margin="0,0,10,0"
                                              Foreground="{Binding SessionsSectionButtonForeground}"
                                              Icon="History" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[SectionSessionsNav]}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Click="NewSessionSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionNewSessionNav]}"
                            Visibility="{Binding ExpertOnlyVisibility}"
                            Background="{Binding NewSessionSectionButtonBackground}"
                            BorderBrush="{Binding NewSessionSectionButtonBackground}"
                            Foreground="{Binding NewSessionSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18" Height="18" Margin="0,0,10,0"
                                              Foreground="{Binding NewSessionSectionButtonForeground}"
                                              Icon="ChatAdd" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[SectionNewSessionNav]}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Click="SetupSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionSetupNav]}"
                            Background="{Binding SetupSectionButtonBackground}"
                            BorderBrush="{Binding SetupSectionButtonBackground}"
                            Foreground="{Binding SetupSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18" Height="18" Margin="0,0,10,0"
                                              Foreground="{Binding SetupSectionButtonForeground}"
                                              Icon="ArrowDownload" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[SectionSetupNav]}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Click="ExtensionsSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionExtensionsNav]}"
                            Background="{Binding ExtensionsSectionButtonBackground}"
                            BorderBrush="{Binding ExtensionsSectionButtonBackground}"
                            Foreground="{Binding ExtensionsSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18" Height="18" Margin="0,0,10,0"
                                              Foreground="{Binding ExtensionsSectionButtonForeground}"
                                              Icon="PuzzlePiece" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[SectionExtensionsNav]}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SideNavButtonStyle}"
                            Margin="0"
                            Click="SettingsSectionButton_Click"
                            AutomationProperties.Name="{Binding Strings[SectionSettingsNav]}"
                            Background="{Binding SettingsSectionButtonBackground}"
                            BorderBrush="{Binding SettingsSectionButtonBackground}"
                            Foreground="{Binding SettingsSectionButtonForeground}">
                        <StackPanel Orientation="Horizontal">
                            <icons:FluentIcon Width="18" Height="18" Margin="0,0,10,0"
                                              Foreground="{Binding SettingsSectionButtonForeground}"
                                              Icon="Settings" IconVariant="Regular" />
                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Strings[SectionSettingsNav]}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <CheckBox Margin="0,0,0,4"
                              Foreground="#FFFDF9"
                              IsChecked="{Binding IsBeginnerModeEnabled, Mode=TwoWay}"
                              Content="{Binding Strings[BeginnerModeLabel]}" />
                    <TextBlock Margin="24,0,0,12"
                               FontSize="10"
                               Foreground="#9FB7C5"
                               TextWrapping="Wrap"
                               Text="{Binding Strings[BeginnerModeRecommended]}" />
                    <TextBlock FontSize="11"
                               Foreground="#B7D0DA"
                               Text="{Binding CurrentAppVersionText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid Visibility="{Binding HomeSectionVisibility}">
                <Border Visibility="{Binding BeginnerOnboardingVisibility}"
                        Padding="26"
                        CornerRadius="28"
                        Background="#FFFDF9"
                        BorderBrush="#E7DBCC"
                        BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <Border HorizontalAlignment="Left"
                                        Padding="10,5"
                                        CornerRadius="12"
                                        Background="#FCE7C3">
                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="#B86E10"
                                               Text="{Binding Strings[OnboardingEyebrow]}" />
                                </Border>
                                <TextBlock Margin="0,14,0,0" FontSize="32" FontWeight="Bold"
                                           Foreground="#16212B" Text="{Binding Strings[OnboardingTitle]}" />
                                <TextBlock Margin="0,8,0,0" MaxWidth="680" FontSize="15"
                                           Foreground="#475467" TextWrapping="Wrap"
                                           Text="{Binding Strings[OnboardingSubtitle]}" />

                                <UniformGrid Margin="0,22,0,0" Columns="2">
                                    <Border Margin="0,0,8,8" Padding="16" CornerRadius="20" Background="#F7F3EC">
                                        <StackPanel>
                                            <icons:FluentIcon Width="22" Height="22" Foreground="#A84A12" Icon="Laptop" IconVariant="Regular" />
                                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[OnboardingStep1Title]}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding Strings[OnboardingStep1Text]}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="8,0,0,8" Padding="16" CornerRadius="20" Background="#F7F3EC">
                                        <StackPanel>
                                            <icons:FluentIcon Width="22" Height="22" Foreground="#A84A12" Icon="Bot" IconVariant="Regular" />
                                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[OnboardingStep2Title]}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding Strings[OnboardingStep2Text]}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="0,8,8,0" Padding="16" CornerRadius="20" Background="#F7F3EC">
                                        <StackPanel>
                                            <icons:FluentIcon Width="22" Height="22" Foreground="#A84A12" Icon="BrainCircuit" IconVariant="Regular" />
                                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[OnboardingStep3Title]}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding Strings[OnboardingStep3Text]}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Margin="8,8,0,0" Padding="16" CornerRadius="20" Background="#F7F3EC">
                                        <StackPanel>
                                            <icons:FluentIcon Width="22" Height="22" Foreground="#A84A12" Icon="Play" IconVariant="Regular" />
                                            <TextBlock Margin="0,10,0,0" FontSize="15" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[OnboardingStep4Title]}" />
                                            <TextBlock Margin="0,6,0,0" Foreground="#475467" TextWrapping="Wrap" Text="{Binding Strings[OnboardingStep4Text]}" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>

                            <Border Grid.Column="2" Padding="20" CornerRadius="24" Background="#16212B">
                                <StackPanel VerticalAlignment="Center">
