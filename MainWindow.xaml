                                               FontWeight="SemiBold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[DetailOpenCodeBridge]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Visibility="{Binding ExpertOnlyVisibility}"
                                               Foreground="#C3D2DC"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedSessionOpenCodeBridgeText}" />
