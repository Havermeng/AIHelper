                        Padding="10"
                        CornerRadius="18"
                        Background="#203240">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button MinWidth="126" Margin="0,0,8,0" Click="RefreshButton_Click"
                                IsEnabled="{Binding IsRefreshAvailable}" Content="{Binding Strings[Refresh]}" />
                        <Button MinWidth="170" Margin="0,0,8,0" Click="ResumeSelectedSessionButton_Click"
                                IsEnabled="{Binding CanResumeSelectedSession}" Content="{Binding Strings[ResumeInTerminal]}" />
