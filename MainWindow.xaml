                                                  Content="{Binding Strings[NewSessionOssToggle]}" />
                                    </WrapPanel>
                                </Border>
                                <TextBlock Margin="2,0,0,0"
                                           FontSize="12"
                                           Foreground="#667085"
                                           TextWrapping="Wrap"
                                           Text="{Binding NewSessionFlagsHelpText}" />

