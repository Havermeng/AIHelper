                                            <TextBlock Grid.Row="5" Foreground="#9AB0BE" Text="{Binding Strings[DetailToolCalls]}" />
                                            <TextBlock Grid.Row="5" Grid.Column="1" Foreground="#FFFDF9" Text="{Binding SelectedSession.ToolCallCount, TargetNullValue=-}" />

                                            <TextBlock Grid.Row="6" Foreground="#9AB0BE" Text="{Binding Strings[DetailModel]}" />
                                            <TextBlock Grid.Row="6" Grid.Column="1" Foreground="#FFFDF9" Text="{Binding SelectedSession.ModelProvider, TargetNullValue=-}" />

                                            <TextBlock Grid.Row="7" Foreground="#9AB0BE" Text="{Binding Strings[DetailSource]}" />
                                            <TextBlock Grid.Row="7" Grid.Column="1" Foreground="#FFFDF9" Text="{Binding SelectedSession.Source, TargetNullValue=-}" />

                                            <TextBlock Grid.Row="8" Foreground="#9AB0BE" Text="{Binding Strings[DetailCliVersion]}" />
                                            <TextBlock Grid.Row="8" Grid.Column="1" Foreground="#FFFDF9" Text="{Binding SelectedSession.CliVersion, TargetNullValue=-}" />

                                            <TextBlock Grid.Row="9" Foreground="#9AB0BE" Text="{Binding Strings[DetailCwd]}" />
                                            <TextBlock Grid.Row="9"
                                                       Grid.Column="1"
                                                       Foreground="#FFFDF9"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding SelectedSession.WorkingDirectory, TargetNullValue=-}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[DetailFavorite]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#C3D2DC"
                                               Text="{Binding SelectedSessionFavoriteText}" />

                                    <Border Margin="0,18,0,0"
                                            Visibility="{Binding ExpertOnlyVisibility}"
                                            Padding="12"
                                            CornerRadius="16"
                                            Background="#203240">
                                        <StackPanel>
                                            <TextBlock FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFFDF9"
                                                       Text="{Binding Strings[DetailQuickActions]}" />
                                            <UniformGrid Margin="0,10,0,0"
                                                         Columns="2">
                                                <Button Margin="0,0,8,8"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="CopySelectedSessionIdButton_Click"
                                                        Content="{Binding Strings[CopySessionId]}" />
                                                <Button Margin="8,0,0,8"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="OpenSelectedSessionDirectoryButton_Click"
                                                        IsEnabled="{Binding CanOpenSelectedSessionDirectory}"
                                                        Content="{Binding Strings[OpenSessionDirectory]}" />
                                                <Button Margin="0,0,8,0"
                                                        Style="{StaticResource ActionButtonStyle}"
                                                        Click="ToggleSelectedSessionHiddenButton_Click"
                                                        IsEnabled="{Binding CanToggleSelectedSessionHidden}"
                                                        Content="{Binding ToggleSessionHiddenButtonText}" />
                                                <Button Margin="8,0,0,0"
