                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{Binding NewSessionAccessSummaryForeground}"
                                                   Text="{Binding NewSessionAccessSummaryTitle}" />
                                        <TextBlock Margin="0,4,0,0"
