                                                  IsTextSearchEnabled="False"
                                                  ItemsSource="{Binding ProfileSuggestions}"
                                                  Text="{Binding NewSessionProfile, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="2,8,0,0"
                                                   FontSize="12"
                                                   Foreground="#667085"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding NewSessionProfileHelpText}" />
                                    </StackPanel>
                                </Grid>

