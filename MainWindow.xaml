                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="#16212B"
                                                   Text="{Binding Strings[NewSessionProfileLabel]}" />
                                        <ComboBox Margin="0,10,0,0"
