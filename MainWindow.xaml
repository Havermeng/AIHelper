                                    <ComboBox.Resources>
                                        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FFFDF9" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFDF9" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#FFFDF9" />
                                        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFDF9" />
                                    </ComboBox.Resources>
