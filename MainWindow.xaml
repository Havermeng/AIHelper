                                    </Border>
                                </StackPanel>

                                <Grid Grid.Row="2">
                                    <DataGrid ItemsSource="{Binding Sessions}"
                                              AutomationProperties.Name="{Binding Strings[SectionSessionsNav]}"
                                              SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
