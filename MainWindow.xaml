                                            <DataGridTemplateColumn Width="*"
                                                                    Header="{Binding Data.Strings[GridSession], Source={StaticResource ViewModelProxy}}">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,6,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock FontWeight="SemiBold"
                                                                           Text="{Binding DisplayTitle}" />
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="8,2"
                                                                        CornerRadius="10"
                                                                        Background="#FDE8C8"
                                                                        Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <TextBlock FontSize="11"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="#9A5A00"
                                                                               Text="{Binding FavoriteBadgeText}" />
                                                                </Border>
                                                                <Border Margin="8,0,0,0"
                                                                        Padding="8,2"
                                                                        CornerRadius="10"
                                                                        Background="#E4E7EC"
                                                                        Visibility="{Binding IsHidden, Converter={StaticResource BooleanToVisibilityConverter}}">
