                        <StackPanel>
                            <TextBlock FontSize="{Binding HomeTitleFontSize}" FontWeight="Bold" Foreground="#16212B" Text="{Binding Strings[HomeTitle]}" />
                            <TextBlock Margin="0,5,0,0" MaxWidth="900" HorizontalAlignment="Left" FontSize="13.5"
                                       Foreground="#475467" TextWrapping="Wrap" Text="{Binding Strings[HomeSubtitle]}" />
