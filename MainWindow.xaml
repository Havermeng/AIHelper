                                        <Button Style="{StaticResource ActionButtonStyle}"
                                                Click="ResumeSelectedSessionInOpenCodeButton_Click"
                                                IsEnabled="{Binding CanResumeSelectedSessionInOpenCode}"
                                                ToolTip="{Binding SelectedSessionOpenCodeBridgeText}"
                                                Content="{Binding OpenCodeResumeButtonText}" />
                                        <Button Margin="0,8,0,0"
                                                Style="{StaticResource ActionButtonStyle}"
                                                Click="RefreshSelectedSessionOpenCodeBridgeButton_Click"
                                                IsEnabled="{Binding CanRefreshSelectedSessionOpenCodeBridge}"
                                                ToolTip="{Binding SelectedSessionOpenCodeBridgeText}"
                                                Content="{Binding Strings[RefreshOpenCodeBridge]}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[DetailNotes]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#C3D2DC"
                                               Text="{Binding Strings[NotesHint]}" />
                                    <TextBox Margin="0,10,0,0"
                                             MinHeight="120"
                                             AcceptsReturn="True"
                                             IsEnabled="{Binding CanEditSelectedSessionNote}"
                                             TextWrapping="Wrap"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             Background="#FFFDF9"
                                             Foreground="#16212B"
                                             Text="{Binding SelectedSessionNote, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Margin="0,10,0,0"
                                                Orientation="Horizontal">
                                        <Button Width="108"
                                                Click="SaveSelectedNoteButton_Click"
                                                IsEnabled="{Binding CanSaveSelectedSessionNote}"
                                                Content="{Binding Strings[SaveNote]}" />
                                        <Button Width="108"
                                                Margin="10,0,0,0"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Click="ClearSelectedNoteButton_Click"
                                                IsEnabled="{Binding CanClearSelectedSessionNote}"
                                                Content="{Binding Strings[ClearNote]}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,18,0,0"
                                               Visibility="{Binding ExpertOnlyVisibility}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[DetailSessionFile]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Visibility="{Binding ExpertOnlyVisibility}"
                                               Foreground="#C3D2DC"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedSession.RelativePath, TargetNullValue=-}" />

                                    <TextBlock Margin="0,18,0,0"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFDF9"
                                               Text="{Binding Strings[DetailLastMessage]}" />
                                    <TextBlock Margin="0,8,0,0"
                                               Foreground="#C3D2DC"
                                               TextWrapping="Wrap"
                                               Text="{Binding SelectedSession.LastMessagePreview, TargetNullValue=-}" />

                                    <StackPanel Visibility="{Binding ExpertOnlyVisibility}">
                                        <TextBlock Margin="0,18,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFFDF9"
                                                   Text="{Binding Strings[DetailTranscript]}" />
                                        <ProgressBar Margin="0,10,0,0"
                                                     Height="6"
                                                     IsIndeterminate="True"
                                                     Visibility="{Binding IsSelectedSessionTranscriptLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBox Margin="0,10,0,0"
                                                 MinHeight="340"
                                                 AcceptsReturn="True"
                                                 IsReadOnly="True"
                                                 TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 FontFamily="Consolas"
                                                 Background="#0F1720"
                                                 Foreground="#E9EEF2"
                                                 Text="{Binding SelectedSessionTranscriptText, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>

            <Grid Visibility="{Binding NewSessionSectionVisibility}"
                  DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
