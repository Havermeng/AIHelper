                                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightLightBrushKey}" Color="#FFFDF9" />
                                            </ComboBox.Resources>
                                        </ComboBox>
                                        <TextBlock Margin="2,8,0,0"
                                                   FontSize="12"
                                                   Foreground="#667085"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding NewSessionSandboxHelpText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
